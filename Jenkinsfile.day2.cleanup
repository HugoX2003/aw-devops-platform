pipeline {
  agent any

  environment {
    AWS_REGION   = "us-east-1"
    CLUSTER_NAME = "dev-challenge-hugo"

    DEPLOY_PATH  = "k8s/day-10/nginx-deployment.yaml"
    SVC_PATH     = "k8s/day-10/nginx-service.yaml"

    SVC_NAME     = "nginx-service"
    DEPLOY_NAME  = "nginx-deployment"
    APP_LABEL    = "app=nginx"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Verify tools') {
      steps {
        sh '''
          set -e
          aws --version
          kubectl version --client=true
        '''
      }
    }

    stage('Configure kubeconfig') {
      steps {
        withCredentials([
          string(credentialsId: 'aws_access_key_id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws_secret_access_key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh '''
            set -e
            export AWS_DEFAULT_REGION="${AWS_REGION}"
            export KUBECONFIG="$WORKSPACE/kubeconfig"

            aws eks update-kubeconfig --name "${CLUSTER_NAME}" --region "${AWS_REGION}" --kubeconfig "$KUBECONFIG"
            kubectl get nodes -o wide
          '''
        }
      }
    }

    stage('Delete Service (LoadBalancer) and wait') {
      steps {
        withCredentials([
          string(credentialsId: 'aws_access_key_id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws_secret_access_key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh '''
            set -e
            export AWS_DEFAULT_REGION="${AWS_REGION}"
            export KUBECONFIG="$WORKSPACE/kubeconfig"

            # Capturar hostname del LB si existe
            LB=$(kubectl get svc "${SVC_NAME}" -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
            echo "LB_DNS=$LB"

            # Borrar Service (por manifiesto si existe, si no por nombre)
            if [ -f "${SVC_PATH}" ]; then
              kubectl delete -f "${SVC_PATH}" --ignore-not-found=true
            else
              kubectl delete svc "${SVC_NAME}" --ignore-not-found=true
            fi

            # Esperar que el Service desaparezca
            for i in $(seq 1 60); do
              if kubectl get svc "${SVC_NAME}" >/dev/null 2>&1; then
                echo "Esperando eliminación de Service... ($i/60)"
                sleep 10
              else
                echo "Service eliminado."
                break
              fi
            done

            # Esperar que el LB desaparezca en AWS (si teníamos DNS)
            if [ -n "$LB" ]; then
              for i in $(seq 1 60); do
                FOUND=$(aws elbv2 describe-load-balancers --region "$AWS_REGION" \
                  --query "LoadBalancers[?DNSName=='$LB'].LoadBalancerArn" --output text 2>/dev/null || true)
                if [ -z "$FOUND" ] || [ "$FOUND" = "None" ]; then
                  echo "LB eliminado en AWS."
                  break
                fi
                echo "Esperando eliminación del LB en AWS... ($i/60)"
                sleep 10
              done
            fi
          '''
        }
      }
    }

    stage('Delete Deployment and verify') {
      steps {
        withCredentials([
          string(credentialsId: 'aws_access_key_id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws_secret_access_key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh '''
            set -e
            export KUBECONFIG="$WORKSPACE/kubeconfig"

            # Borrar Deployment (por manifiesto si existe, si no por nombre)
            if [ -f "${DEPLOY_PATH}" ]; then
              kubectl delete -f "${DEPLOY_PATH}" --ignore-not-found=true
            else
              kubectl delete deployment "${DEPLOY_NAME}" --ignore-not-found=true
            fi

            echo "Verificación final:"
            kubectl get deployment "${DEPLOY_NAME}" || true
            kubectl get svc "${SVC_NAME}" || true
            kubectl get pods -l "${APP_LABEL}" || true
          '''
        }
      }
    }
  }
}