pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  environment {
    AWS_REGION   = "us-east-1"
    CLUSTER_NAME = "dev-challenge-hugo"
    TF_DIR       = "infra/terraform/day3-k8s"
  }

  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Verify tools') {
      steps {
        sh '''
          set -e
          aws --version
          kubectl version --client=true
          terraform version
        '''
      }
    }

    stage('Configure kubeconfig (~/.kube/config)') {
      steps {
        withCredentials([
          string(credentialsId: 'aws_access_key_id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws_secret_access_key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh '''
            set -e
            export AWS_DEFAULT_REGION="${AWS_REGION}"

            mkdir -p "$HOME/.kube"
            aws eks update-kubeconfig \
              --name "${CLUSTER_NAME}" \
              --region "${AWS_REGION}" \
              --kubeconfig "$HOME/.kube/config"

            export KUBECONFIG="$HOME/.kube/config"
            kubectl get nodes -o wide
          '''
        }
      }
    }

    stage('Terraform destroy') {
      steps {
        withCredentials([
          string(credentialsId: 'aws_access_key_id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws_secret_access_key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh(label: 'Destroy (bash)', script: '''#!/usr/bin/env bash
set -euo pipefail
export KUBECONFIG="$HOME/.kube/config"

cd "${TF_DIR}"

terraform init
terraform destroy -auto-approve

echo "Verificación final (deben no existir):"
kubectl get deploy tf-nginx-deployment || true
kubectl get svc tf-nginx-service || true
kubectl get pods -l app=tf-nginx || true
''')
        }
      }
    }
  }
}